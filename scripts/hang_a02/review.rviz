Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: Filter sweep
      Enabled: true
      Topic:
        Value: /comparison_cloud
        Durability Policy: Transient Local
      Color Transformer: AxisColor
      Autocompute Value Bounds:
        Value: false
        Min Value: 0.12
        Max Value: 2.5
      Axis: Z
      Size (Pixels): 2
      Style: Points
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Labels and trajectory
      Enabled: true
      Topic:
        Value: /comparison_markers
        Durability Policy: Transient Local
      Value: true
  Global Options:
    Background Color: 10; 16; 24
    Fixed Frame: map
    Frame Rate: 15
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 0
      Scale: 20
      X: 22
      Y: 3
      Target Frame: map
Window Geometry:
  Width: 1520
  Height: 980
  X: 65
  Y: 42
